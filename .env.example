# =================================================================
# REACTIVE RESUME TRACKER - ENVIRONMENT CONFIGURATION
# =================================================================
# Copy this file to .env and fill in your actual values
# This file is safe to commit - never commit .env with real secrets!

# =================================================================
# 🌍 BASIC CONFIGURATION
# =================================================================
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000
STORAGE_URL=http://localhost:9000

# =================================================================
# 🗄️ DATABASE CONFIGURATION  
# =================================================================
# PostgreSQL Database URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reactive_resume

# =================================================================
# 🔐 AUTHENTICATION & SECURITY
# =================================================================
# Generate strong random strings: openssl rand -base64 32
ACCESS_TOKEN_SECRET=your-super-secret-access-token-here
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-here

# =================================================================
# 🎯 LLM INTEGRATION (AI Features) - NEW!
# =================================================================
# Choose your provider: anthropic | openai | local
LLM_PROVIDER=anthropic

# Anthropic Claude (Recommended for best performance)
ANTHROPIC_API_KEY=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
ANTHROPIC_MODEL=claude-opus-4-20250514

# OpenAI GPT (Alternative option)
OPENAI_API_KEY=sk-your-openai-key-here  
OPENAI_MODEL=gpt-4-turbo-preview

# Local LLM (Ollama/LM Studio - Future use)
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=llama3:8b

# =================================================================
# 🖨️ PDF GENERATION (Puppeteer)
# =================================================================
CHROME_TOKEN=your-chrome-token
CHROME_URL=ws://localhost:3001
CHROME_IGNORE_HTTPS_ERRORS=false

# =================================================================
# 💾 FILE STORAGE (MinIO/S3)
# =================================================================
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=reactive-resume
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_USE_SSL=false
STORAGE_SKIP_BUCKET_CHECK=false

# =================================================================
# 📧 EMAIL CONFIGURATION (Optional)
# =================================================================
MAIL_FROM=noreply@yourdomain.com
# Example: smtps://username:password@smtp.gmail.com:465
SMTP_URL=smtps://username:password@smtp.gmail.com:465

# =================================================================
# 🔗 OAUTH PROVIDERS (Optional)
# =================================================================
# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# Google OAuth  
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# =================================================================
# 🚧 FEATURE FLAGS (Optional)
# =================================================================
DISABLE_SIGNUPS=false
DISABLE_EMAIL_AUTH=false

# =================================================================
# 🚀 QUICK START GUIDE
# =================================================================
# 1. Copy this file: cp .env.example .env
# 2. Set DATABASE_URL to your PostgreSQL database
# 3. Generate JWT secrets: openssl rand -base64 32
# 4. Add LLM API key (Anthropic Claude recommended)
# 5. Configure storage (MinIO for local development)
# 6. Start services: pnpm dev
# Environment
NODE_ENV=development

# Ports
PORT=3000

# URLs
# These URLs must reference a publicly accessible domain or IP address, not a docker container ID (depending on your compose setup)
PUBLIC_URL=http://localhost:3000
STORAGE_URL=http://localhost:9000/default # default is the bucket name specified in the STORAGE_BUCKET variable

# Database (Prisma/PostgreSQL)
# This can be swapped out to use any other database, like MySQL
# Note: This is used only in the compose.yml file
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Database (Prisma/PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres?schema=public

# Authentication Secrets
# generated with `openssl rand -base64 64`
ACCESS_TOKEN_SECRET=access_token_secret
REFRESH_TOKEN_SECRET=refresh_token_secret

# Chrome Browser (for printing)
# generated with `openssl rand -hex 32`
CHROME_PORT=8080
CHROME_TOKEN=chrome_token
CHROME_URL=ws://localhost:8080
# Launch puppeteer with flag to ignore https errors
# CHROME_IGNORE_HTTPS_ERRORS=true

# Mail Server (for e-mails)
# For testing, you can use https://ethereal.email/create
MAIL_FROM=noreply@localhost
# SMTP_URL=smtp://username:password@smtp.ethereal.email:587

# Storage
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=default
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_USE_SSL=false
STORAGE_SKIP_BUCKET_CHECK=false

# Nx Cloud (Optional)
# NX_CLOUD_ACCESS_TOKEN=

# Crowdin (Optional)
# CROWDIN_PROJECT_ID=
# CROWDIN_PERSONAL_TOKEN=

# Feature Flags (Optional)
# DISABLE_SIGNUPS=false
# DISABLE_EMAIL_AUTH=false

# GitHub (OAuth, Optional)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=http://localhost:5173/api/auth/github/callback

# Google (OAuth, Optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback

# OpenID (Optional)
# VITE_OPENID_NAME=
# OPENID_AUTHORIZATION_URL=
# OPENID_CALLBACK_URL=http://localhost:5173/api/auth/openid/callback
# OPENID_CLIENT_ID=
# OPENID_CLIENT_SECRET=
# OPENID_ISSUER=
# OPENID_SCOPE=openid profile email
# OPENID_TOKEN_URL=
# OPENID_USER_INFO_URL=
