generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Provider {
  email
  github
  google
  openid
}

enum Visibility {
  public
  private
}

enum ContentType {
  WORK_EXPERIENCE
  PROJECT
  TECHNICAL_SKILL
  SOFT_SKILL
  EDUCATION
  CERTIFICATION
  VOLUNTEER_EXPERIENCE
  PUBLICATION
  AWARD
  LANGUAGE
  INTEREST
}

enum ApplicationStatus {
  DRAFT
  APPLIED
  INTERVIEW_SCHEDULED
  INTERVIEWED
  OFFER_RECEIVED
  REJECTED
  ACCEPTED
  WITHDRAWN
}

enum LLMProvider {
  OPENAI
  ANTHROPIC
  GOOGLE
  OLLAMA
}

model User {
  id               String   @id @default(cuid())
  name             String
  picture          String?
  username         String   @unique
  email            String   @unique
  locale           String   @default("en-US")
  emailVerified    Boolean  @default(false)
  twoFactorEnabled Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  provider         Provider
  secrets          Secrets?
  resumes          Resume[]
  contentLibrary   ContentLibrary[]
  jobApplications  JobApplication[]
  tags             Tag[]
}

model Secrets {
  id                   String   @id @default(cuid())
  password             String?
  lastSignedIn         DateTime @default(now())
  verificationToken    String?
  twoFactorSecret      String?
  twoFactorBackupCodes String   @default("[]")
  refreshToken         String?
  resetToken           String?  @unique
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, id])
}

model Resume {
  id              String          @id @default(cuid())
  title           String
  slug            String
  data            String          @default("{}")
  visibility      Visibility      @default(private)
  locked          Boolean         @default(false)
  statistics      Statistics?
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobApplicationId String?
  jobApplication  JobApplication? @relation(fields: [jobApplicationId], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([userId, id])
  @@unique([userId, slug])
  @@index(fields: [userId])
}

model Statistics {
  id        String   @id @default(cuid())
  views     Int      @default(0)
  downloads Int      @default(0)
  resumeId  String   @unique
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([resumeId, id])
}

model ContentLibrary {
  id          String        @id @default(cuid())
  title       String
  description String?
  content     String        @default("{}")
  type        ContentType
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags        ContentTag[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  // Specific fields for different content types
  company     String?       // For work experience
  position    String?       // For work experience/education
  startDate   DateTime?
  endDate     DateTime?
  location    String?
  skills      String        @default("[]")
  achievements String       @default("[]")
  
  @@index(fields: [userId, type])
  @@index(fields: [userId, createdAt])
}

model Tag {
  id        String       @id @default(cuid())
  name      String
  color     String?      // Hex color for UI
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   ContentTag[]
  createdAt DateTime     @default(now())
  
  @@unique([userId, name])
  @@index(fields: [userId])
}

model ContentTag {
  id        String         @id @default(cuid())
  contentId String
  tagId     String
  content   ContentLibrary @relation(fields: [contentId], references: [id], onDelete: Cascade)
  tag       Tag            @relation(fields: [tagId], references: [id], onDelete: Cascade)
  
  @@unique([contentId, tagId])
}

model JobApplication {
  id                String            @id @default(cuid())
  title             String            // Job title
  company           String
  description       String?           // Job description
  requirements      String            @default("[]")
  extractedTags     String            @default("[]")
  url               String?           // Job posting URL
  status            ApplicationStatus @default(DRAFT)
  appliedDate       DateTime?
  notes             String?
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumes           Resume[]
  coverLetters      CoverLetter[]
  interviews        Interview[]
  generatedContent  GeneratedContent[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  
  @@index(fields: [userId, status])
  @@index(fields: [userId, createdAt])
}

model CoverLetter {
  id               String         @id @default(cuid())
  content          String
  jobApplicationId String
  jobApplication   JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  
  @@index(fields: [jobApplicationId])
}

model Interview {
  id               String         @id @default(cuid())
  type             String         // "voice", "text", "video"
  content          String?        // Interview transcript/notes
  audioUrl         String?        // URL to audio file if voice interview
  insights         String?        // AI-generated insights
  jobApplicationId String
  jobApplication   JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())
  
  @@index(fields: [jobApplicationId])
}

model GeneratedContent {
  id               String         @id @default(cuid())
  type             String         // "resume", "cover_letter"
  prompt           String         // The prompt used for generation
  response         String         // The generated content
  llmProvider      LLMProvider    // Which LLM was used
  model            String         // Specific model (e.g., "gpt-4", "claude-3")
  contentIds       String         @default("[]")
  jobApplicationId String
  jobApplication   JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())
  
  @@index(fields: [jobApplicationId])
}
