generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Provider {
  email
  github
  google
  openid
}

enum UserType {
  GENERAL_CONSUMER
  DEVELOPER
}

enum Visibility {
  public
  private
}

enum ApplicationStatus {
  DRAFT
  APPLIED
  INTERVIEW_SCHEDULED
  INTERVIEWED
  OFFER_RECEIVED
  REJECTED
  ACCEPTED
  WITHDRAWN
}

enum LLMProvider {
  OPENAI
  ANTHROPIC
  GOOGLE
  OLLAMA
}

model User {
  id               String   @id @default(cuid())
  name             String
  picture          String?
  username         String   @unique
  email            String   @unique
  locale           String   @default("en-US")
  emailVerified    Boolean  @default(false)
  twoFactorEnabled Boolean  @default(false)
  userType         UserType @default(GENERAL_CONSUMER)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  provider         Provider
  secrets          Secrets?
  resumes          Resume[]
  content          Content[]
  jobApplications  JobApplication[]
  tags             Tag[]
  llmSettings      UserLLMSettings?
}

model Secrets {
  id                   String   @id @default(cuid())
  password             String?
  lastSignedIn         DateTime @default(now())
  verificationToken    String?
  twoFactorSecret      String?
  twoFactorBackupCodes String   @default("[]")
  refreshToken         String?
  resetToken           String?  @unique
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, id])
}

model UserLLMSettings {
  id          String       @id @default(cuid())
  provider    LLMProvider  @default(OPENAI)
  
  // System Fallback Settings
  useSystemDefaultAsBackup Boolean  @default(false)  // Use system as backup when user keys fail
  
  // OpenAI Settings
  openaiApiKey    String?
  openaiModel     String?  @default("gpt-4-turbo-preview")
  openaiBaseUrl   String?  // For custom OpenAI endpoints
  
  // Anthropic Settings
  anthropicApiKey String?
  anthropicModel  String?  @default("claude-3-5-sonnet-20241022")
  
  // Ollama/Local Settings
  ollamaApiKey    String?  @default("sk-1234567890abcdef")
  ollamaBaseUrl   String?  @default("http://localhost:11434/v1")
  ollamaModel     String?  @default("llama3:8b")
  
  // Common Settings
  maxTokens       Int      @default(4000)
  temperature     Float    @default(0.1)
  
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([userId, id])
}

model Resume {
  id              String          @id @default(cuid())
  title           String
  slug            String
  data            String          @default("{}")
  visibility      Visibility      @default(private)
  locked          Boolean         @default(false)
  statistics      Statistics?
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobApplicationId String?
  jobApplication  JobApplication? @relation(fields: [jobApplicationId], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([userId, id])
  @@unique([userId, slug])
  @@index(fields: [userId])
}

model Statistics {
  id        String   @id @default(cuid())
  views     Int      @default(0)
  downloads Int      @default(0)
  resumeId  String   @unique
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([resumeId, id])
}

model Section {
  id               String    @id @default(cuid())
  key              String    @unique
  name             String
  description      String?
  icon             String?
  schema           String    @default("{}")
  validation       String    @default("{}")
  order            Int       @default(0)
  isActive         Boolean   @default(true)
  isDefault        Boolean   @default(false)
  isCustomizable   Boolean   @default(true)
  content          Content[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  
  @@index(fields: [key])
  @@index(fields: [order])
}

model Content {
  id          String        @id @default(cuid())
  title       String
  description String?
  sectionId   String
  section     Section       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Variant/Master relationship
  sourceContentId String?   // Points to master content if this is a variant
  sourceContent   Content?  @relation("ContentVariants", fields: [sourceContentId], references: [id], onDelete: Cascade)
  variants        Content[] @relation("ContentVariants")
  
  // RAG-ready transformation fields
  data                String    @default("{}")  // Structured JSON data according to section schema
  embedding           String?   // Vector embedding for RAG (JSON array)
  embeddingHash       String?   // Hash of embedding for deduplication
  transformationDate  DateTime? // When the content was transformed
  transformationNotes String?   // Metadata about the transformation process
  
  tags        ContentTag[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  @@index(fields: [userId, sectionId])
  @@index(fields: [userId, createdAt])
  @@index(fields: [sourceContentId])
}

model Tag {
  id        String       @id @default(cuid())
  name      String
  color     String?      // Hex color for UI
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   ContentTag[]
  createdAt DateTime     @default(now())
  
  @@unique([userId, name])
  @@index(fields: [userId])
}

model ContentTag {
  id        String  @id @default(cuid())
  contentId String
  tagId     String
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  
  @@unique([contentId, tagId])
}

model JobApplication {
  id                String            @id @default(cuid())
  title             String            // Job title
  company           String
  description       String?           // Job description
  requirements      String            @default("[]")
  extractedTags     String            @default("[]")
  url               String?           // Job posting URL
  status            ApplicationStatus @default(DRAFT)
  appliedDate       DateTime?
  notes             String?
  // --- RAG fields start ---
  embedding           String?   // Vector embeddings for content matching
  embeddingHash       String?   // Embedding cache hash (for caching)
  // --- RAG fields end ---
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumes           Resume[]
  coverLetters      CoverLetter[]
  interviews        Interview[]
  generatedContent  GeneratedContent[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  
  @@index(fields: [userId, status])
  @@index(fields: [userId, createdAt])
}

model CoverLetter {
  id               String         @id @default(cuid())
  content          String
  jobApplicationId String
  jobApplication   JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  
  @@index(fields: [jobApplicationId])
}

model Interview {
  id               String         @id @default(cuid())
  type             String         // "voice", "text", "video"
  content          String?        // Interview transcript/notes
  audioUrl         String?        // URL to audio file if voice interview
  insights         String?        // AI-generated insights
  jobApplicationId String
  jobApplication   JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())
  
  @@index(fields: [jobApplicationId])
}

model GeneratedContent {
  id               String         @id @default(cuid())
  type             String         // "resume", "cover_letter"
  prompt           String         // The prompt used for generation
  response         String         // The generated content
  llmProvider      LLMProvider    // Which LLM was used
  model            String         // Specific model (e.g., "gpt-4", "claude-3")
  contentIds       String         @default("[]")
  jobApplicationId String
  jobApplication   JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())
  
  @@index(fields: [jobApplicationId])
}
